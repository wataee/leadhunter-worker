{
  "name": "leadhunter-tg-worker",
  "version": "1.0.0",
  "type": "module",
  "description": "24/7 Telegram lead listener worker for LeadHunter",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "auth": "node auth.js",
    "test": "node --experimental-strip-types --test test/worker.test.js test/auth.test.js test/budget.test.js test/filter.test.js",
    "test:all": "node --experimental-strip-types --test test/worker.test.js test/auth.test.js test/budget.test.js test/filter.test.js",
    "lint": "node --check server.js auth.js && npm --prefix web run lint",
    "lint:all": "node --check server.js auth.js && npm --prefix web run lint",
    "typecheck": "npm --prefix web run typecheck",
    "build": "npm --prefix web run build",
    "build:all": "npm --prefix web run build"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "input": "^1.0.1",
    "telegram": "^2.26.16"
  }
}
