# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Generated StringSession from running "npm run auth"
SESSION_STRING=

# Webhook to send hot leads to (Netlify site endpoint)
WEBHOOK_URL=https://fleurleads-work.netlify.app/api/tg-notify

# Shared secret between worker and Netlify functions (used in X-Webhook-Secret)
# MANDATORY: minimum 16 characters! Generate via: openssl rand -hex 32
WEBHOOK_SECRET=

# Password protection for the single-user web application
APP_PASSWORD=
# Session HMAC secret (optional, defaults to APP_PASSWORD): openssl rand -hex 32
APP_SESSION_SECRET=

# Allowed origin(s) for CORS in Netlify functions (comma-separated)
ALLOWED_ORIGIN=https://fleurleads-work.netlify.app

# Optional: comma-separated list of Telegram channel/group usernames or IDs to listen to
# If empty, all joined channels and supergroups are monitored
ALLOWED_CHATS=

# Optional: Upstash Redis REST credentials (for persistent storage and distributed rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Port for internal health-check server (Render assigns this automatically)
PORT=8080

# External URL of the worker on Render (used for self-ping keepalive)
RENDER_EXTERNAL_URL=
