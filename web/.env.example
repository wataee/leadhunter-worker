# Application single-user password protection
APP_PASSWORD=
APP_SESSION_SECRET=

# Shared secret between Telegram worker and Netlify functions (used in X-Webhook-Secret)
# MANDATORY: minimum 16 characters! Generate via: openssl rand -hex 32
WEBHOOK_SECRET=

# Worker URL on Render for MTProto leads
TG_WORKER_URL=https://leadhunter-worker-uokh.onrender.com

# Allowed origin(s) for CORS (comma-separated)
ALLOWED_ORIGIN=https://fleurleads-work.netlify.app

# Optional: Upstash Redis REST credentials (for persistent storage and distributed rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# YouTube Data API v3 key (Google Cloud Console)
YOUTUBE_API_KEY=

# Telegram Notification Bot (optional for push alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Lead Qualification & Pitch Rewrite (Fallback Pipeline)
# 1) Google Gemini (Primary - free via https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2) Groq Cloud (Secondary fallback - fast & free via https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3) OpenRouter (Tertiary fallback via https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4) Optional Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
